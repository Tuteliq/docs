{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Tuteliq",
  "description": "Documentation for the Tuteliq API — AI-powered child safety detection and synthetic content analysis for text, voice, images, and video.",
  "seo": {
    "indexHiddenPages": false
  },
  "colors": {
    "primary": "#2DD4BF",
    "light": "#5EEAD4",
    "dark": "#14B8A6"
  },
  "favicon": "/favicon.svg",
  "icons": {
    "library": "fontawesome"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "search": {
    "prompt": "Search Tuteliq docs..."
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true,
    "raiseIssue": true
  },
  "api": {
    "baseUrl": "https://api.tuteliq.ai",
    "auth": {
      "method": "bearer"
    },
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "bash",
        "javascript",
        "python",
        "kotlin",
        "swift",
        "csharp",
        "dart"
      ]
    }
  },
  "openapi": "https://api.tuteliq.ai/docs/json",
